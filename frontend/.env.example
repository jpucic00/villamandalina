# Umami analytics — https://cloud.umami.is
# Website ID from your Umami dashboard: Settings → Websites → (your site).
# Leave unset to disable analytics (the tracking script won't load).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional — only set if self-hosting Umami. Defaults to Umami Cloud.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
